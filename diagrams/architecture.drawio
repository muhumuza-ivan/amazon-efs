<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.17" type="device">
  <diagram name="EFS Shared Storage" id="efs-shared-architecture">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============================ Title ============================ -->
        <mxCell id="title" value="Shared Amazon EFS across an EC2 Auto Scaling group &#8212; fully private, multi-AZ" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="No internet gateway &#183; No NAT gateway &#183; No public subnets &#183; No public IPs &#183; No SSH &#183; Access via SSM Session Manager only" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1000" height="24" as="geometry" />
        </mxCell>

        <mxCell id="callout" value="Provisioned by three CloudFormation stacks kept in sync from GitHub&#10;via CloudFormation Git sync:&#160; 01-network &#8594; 02-storage &#8594; 03-compute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;dashed=0;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1080" y="16" width="460" height="58" as="geometry" />
        </mxCell>

        <!-- ============================ Operator + SSM ============================ -->
